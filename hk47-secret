#!/usr/bin/env bash
# secret NAME: a credential from the desktop keyring, on stdout, for $(...) only.
# Never run it bare: a printed secret lands in the transcript for good (PERS-33).
# Keys are the old environment variable names, so `$JIRA_TOKEN_WORK` becomes
# `$(secret JIRA_TOKEN_WORK)` and nothing else in a skill changes.
set -euo pipefail
name=${1:?usage: secret NAME}
[[ $name =~ ^[A-Za-z0-9_]+$ ]] || { echo "secret: bad name" >&2; exit 2; }
# A locked keyring raises its unlock prompt on the desktop; give up rather than
# hang a session that is being driven from the phone.
if v=$(timeout 20 secret-tool lookup service hk47 key "$name" 2>/dev/null) && [ -n "$v" ]; then
    printf %s "$v"
    exit 0
fi
# ponytail: migration fallback to the inherited environment, deleted once the
# fish universals and systemd environment are stripped.
if [ -n "${!name:-}" ]; then
    printf %s "${!name}"
    exit 0
fi
echo "secret: $name is not in the keyring (locked, or never stored)" >&2
exit 1
