# Build artefacts
companion/target/
__pycache__/
*.pyc

# Rendered audition audio: ~39M of output that hk47-render.py rebuilds from the
# source corpus, which lives outside this repo and is referenced by resref.
audition/

# Local session state and tracker wiring. PROJECT.json names a private Plane
# instance and its project UUIDs, and state.json is a running log of one
# machine's work: neither belongs in a public clone.
.claude/

# Local scratch that some helper scripts write next to the repo.
/tmp-out/
